{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Tauri crates and CLI must be updated together",
      "matchPackageNames": ["tauri", "tauri-build", "/^tauri-plugin-/", "@tauri-apps/cli"],
      "groupName": "tauri"
    }
  ]
}
