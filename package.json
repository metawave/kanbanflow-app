{
  "name": "kanbanflow-app",
  "version": "2.0.0",
  "private": true,
  "author": "Marcel Ryser",
  "description": "A application showing the Kanbanflow Website/App",
  "keywords": [
    "kanbanflow",
    "kanban",
    "app",
    "webapp"
  ],
  "repository": "https://github.com/metawave/kanbanflow-app.git",
  "scripts": {
    "icons": "./bin/generateIcons",
    "start": "tauri dev",
    "lint": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "prettify": "prettier --write --ignore-unknown '**/*.*'",
    "dist": "tauri build",
    "dist:unsigned": "tauri build --no-sign",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "prettier": "^3.9.9",
    "prettier-plugin-sh": "^0.19.0"
  }
}
